# ---- Copy to .env (repo root) and fill in. NEVER commit .env ----
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/geu_academic_connect
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5173
# Set to true in production (HTTPS). Defaults to true when NODE_ENV=production
COOKIE_SECURE=false
UPLOAD_DIR=./storage/uploads
MAX_FILE_MB=10

# ---- Initial administrator (used by `npm run seed`) ----
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-Admin-2026!

# ---- Demo data (used by `npm run seed:demo`; fictional users only) ----
SEED_DEMO_PASSWORD=Demo-Pass-2026!

# ---- Optional email (leave blank => in-app notifications only) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
